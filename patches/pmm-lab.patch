diff --git a/kernel/pmmtest.c b/kernel/pmmtest.c
new file mode 100644
index 0000000..8bbfcf4
--- /dev/null
+++ b/kernel/pmmtest.c
@@ -0,0 +1,88 @@
+
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "defs.h"
+
+#define TEST_PAGES 10
+
+void
+test_freepages(void)
+{
+    void *pages[TEST_PAGES];
+    uint64 before, after;
+    int score = 0;
+    int i;
+
+    printf("\n========== Exercise 2 ==========\n");
+
+    before = freepages();
+
+    // T1: Check initial free page count
+    if(before > 10){
+        printf("[PASS] T1: Initial count (+4)\n");
+        score += 4;
+    } else {
+        printf("[FAIL] T1: Initial count\n");
+    }
+
+    // T2: Allocate one page
+    void *p = kalloc();
+    if(p == 0)
+        panic("test: kalloc failed");
+
+    after = freepages();
+
+    if(after == before - 1){
+        printf("[PASS] T2: Single allocation (+4)\n");
+        score += 4;
+    } else {
+        printf("[FAIL] T2: Single allocation\n");
+    }
+
+    // T3: Free one page
+    kfree(p);
+    after = freepages();
+
+    if(after == before){
+        printf("[PASS] T3: Single release (+4)\n");
+        score += 4;
+    } else {
+        printf("[FAIL] T3: Single release\n");
+    }
+
+    // T4: Allocate 10 pages
+    for(i = 0; i < TEST_PAGES; i++){
+        pages[i] = kalloc();
+        if(pages[i] == 0)
+            panic("test: batch allocation failed");
+    }
+
+    after = freepages();
+
+    if(after == before - TEST_PAGES){
+        printf("[PASS] T4: Batch allocation (+4)\n");
+        score += 4;
+    } else {
+        printf("[FAIL] T4: Batch allocation\n");
+    }
+
+    // T5: Free 10 pages
+    for(i = 0; i < TEST_PAGES; i++){
+        kfree(pages[i]);
+    }
+
+    after = freepages();
+
+    if(after == before){
+        printf("[PASS] T5: Batch release (+4)\n");
+        score += 4;
+    } else {
+        printf("[FAIL] T5: Batch release\n");
+    }
+
+    printf("-------------------------------\n");
+    printf("Exercise 2 Score: %d / 20\n", score);
+    printf("================================\n");
+}
